.cover {
  position: relative;
  height: 620rpx;
}

.cover image {
  width: 100%;
  height: 620rpx;
}

.cover-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(20, 14, 10, 0), rgba(20, 14, 10, 0.66));
}

.cover-copy {
  position: absolute;
  left: 32rpx;
  bottom: 72rpx;
  color: #f5f1e8;
}

.cover-city {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.cover-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.sheet {
  position: relative;
  margin-top: -40rpx;
  padding: 36rpx 32rpx 20rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: var(--bg);
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--persimmon);
}

.city-link {
  font-size: 24rpx;
  color: var(--pine);
  border-bottom: 1rpx solid rgba(36, 75, 60, 0.35);
}

.sheet-title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.35;
}

.excerpt {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #303b35;
}

.author {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
}

.author-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex: none;
}

.author-body {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.author-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
}

.author-title {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.follow {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--pine);
  color: #f5f1e8;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.follow.on {
  background: transparent;
  color: var(--muted);
  border: 1rpx solid var(--line);
}

.stat-line {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.dot {
  margin: 0 10rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  padding: 8rpx 0;
  border-radius: 24rpx;
  background: var(--sand);
}

.info {
  width: 50%;
  padding: 20rpx 24rpx;
}

.info-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.info-value {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.tags {
  margin-top: 24rpx;
}

.anchors {
  position: sticky;
  z-index: 5;
  display: flex;
  margin: 12rpx 0 0;
  padding: 18rpx 0;
  background: var(--bg);
  font-size: 26rpx;
  color: var(--pine);
}

.anchors text {
  margin-right: 32rpx;
}

.route-box {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--card);
  font-size: 26rpx;
  line-height: 1.6;
}

.tl-item {
  display: flex;
  margin-top: 8rpx;
}

.tl-rail {
  width: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: none;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: var(--pine);
}

.tl-line {
  width: 2rpx;
  flex: 1;
  min-height: 24rpx;
  background: rgba(36, 75, 60, 0.22);
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding: 0 0 28rpx 8rpx;
}

.tl-day {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--persimmon);
}

.tl-title {
  display: block;
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.tl-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.tl-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #303b35;
}

.place {
  display: inline-block;
  margin: 14rpx 12rpx 0 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--sand);
  color: var(--pine);
  font-size: 22rpx;
}

.para {
  display: block;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.85;
  color: #303b35;
}

.spots {
  width: 686rpx;
  height: 340rpx;
  white-space: nowrap;
}

.spot {
  display: inline-block;
  width: 280rpx;
  white-space: normal;
  vertical-align: top;
}

.spot image {
  width: 280rpx;
  height: 200rpx;
  border-radius: 20rpx;
}

.spot-name {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.spot-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}

.cost {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.cost-name {
  width: 120rpx;
  flex: none;
  font-size: 24rpx;
  color: var(--muted);
}

.cost-track {
  flex: 1;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e9e3d6;
  overflow: hidden;
}

.cost-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--pine);
}

.cost-val {
  width: 120rpx;
  flex: none;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

.budget {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.tip {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.tip-no {
  width: 56rpx;
  flex: none;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  color: var(--persimmon);
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
}

.note {
  display: flex;
  padding: 20rpx 0;
}

.note-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex: none;
}

.note-body {
  flex: 1;
  margin-left: 16rpx;
}

.note-name {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
}

.note-text {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #303b35;
}

.missing {
  padding-top: 40rpx;
}

.ai-banner {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  background: var(--pine);
  display: flex;
  align-items: center;
}

.ai-badge {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: rgba(245, 241, 232, 0.16);
  color: #f5f1e8;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.ai-banner-body {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.ai-banner-title {
  display: block;
  color: #f5f1e8;
  font-size: 28rpx;
  font-weight: 600;
}

.ai-banner-sub {
  display: block;
  margin-top: 6rpx;
  color: rgba(245, 241, 232, 0.62);
  font-size: 22rpx;
}

.arrow.light {
  border-color: rgba(245, 241, 232, 0.6);
}

/* 底栏收藏 / 分享：胶囊按钮样式 */
.dock {
  padding-left: 0;
}

.dock-pill {
  width: 140rpx;
  height: 72rpx;
  margin-right: 20rpx;
  padding: 0;
  flex-direction: row;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 24rpx;
  color: var(--pine);
  transition: border-color 0.24s ease, border-width 0.24s ease, background-color 0.24s ease, color 0.24s ease;
}

.dock-pill-hover {
  border-width: 2rpx;
  border-color: rgba(36, 75, 60, 0.62);
  background: #f7f4ec;
}

.dock-pill .tool-glyph {
  margin: 0 8rpx 0 0;
  font-size: 26rpx;
}

.dock .dock-pill {
  box-sizing: border-box;
  justify-content: center;
  overflow: hidden;
}

.dock-pill.on {
  border-width: 2rpx;
  border-color: rgba(196, 154, 85, 0.75);
  background: rgba(196, 154, 85, 0.12);
  color: var(--gold-deep);
}

.dock .dock-btn.soft {
  flex: none;
  width: 220rpx;
  height: 72rpx;
  margin-left: auto;
  padding: 0;
  background: #1b3a2d;
  border: none;
  color: #f5f1e8;
  font-size: 26rpx;
  transition: background-color 0.24s ease;
}

.dock-btn-hover {
  background: #142c22;
}

/* 分享面板 */
.share-layer {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
}

.share-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 26, 22, 0.45);
  animation: shareFade 0.22s ease;
}

.share-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 32rpx calc(28rpx + constant(safe-area-inset-bottom));
  padding: 32rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--bg);
  animation: shareUp 0.26s ease-out;
}

.share-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.share-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.share-close {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 4rpx;
}

.share-grid {
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  margin-top: 28rpx;
}

.share-item {
  width: 160rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: normal;
}

/* 覆盖小程序 button 默认宽度与居中边距，保证三个图标从左边距起排 */
.share-grid button.share-item {
  width: 160rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
}

.share-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid var(--line);
  color: var(--pine);
  font-family: var(--serif);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.24s ease, border-width 0.24s ease;
}

.share-item-hover .share-ico {
  border-width: 2rpx;
  border-color: rgba(36, 75, 60, 0.6);
}

.share-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--ink);
}

@keyframes shareFade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes shareUp {
  from { transform: translateY(48rpx); opacity: 0.6; }
  to { transform: translateY(0); opacity: 1; }
}
