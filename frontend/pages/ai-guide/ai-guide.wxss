.head {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.ai-badge {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--pine);
  color: #f5f1e8;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.head-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.head-title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.topic-bar {
  margin-top: 32rpx;
  white-space: nowrap;
}

.bubble {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
}

.bubble-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bubble-from {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: var(--persimmon);
}

.bubble-state {
  font-size: 22rpx;
  color: var(--faint);
}

.bubble-state.done {
  color: var(--pine);
}

.bubble-text {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.9;
  white-space: pre-wrap;
  min-height: 200rpx;
}

.cursor {
  color: var(--persimmon);
  animation: blink 0.8s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.bubble-foot {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mini-btn {
  height: 60rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.foot-tip {
  font-size: 22rpx;
  color: var(--faint);
}

/* ===== 升级：多轮对话 + 风格 + 语音 ===== */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  background: var(--bg);
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部信息面板（可收起） */
.top-panel {
  flex: none;
  padding-top: 12rpx;
}
.panel-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}
.mini-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.ai-badge.mini {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}
.mini-title {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
}
.mini-btn {
  flex: none;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-size: 22rpx;
}
.panel-fold {
  flex: none;
  display: flex;
  align-items: center;
  align-self: flex-start;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(36, 75, 60, 0.06);
  color: var(--muted);
  font-size: 22rpx;
  border: 1rpx solid var(--line);
}
/* CSS 绘制的细线箭头，替代字符符号 */
.chev {
  width: 12rpx;
  height: 12rpx;
  margin-left: 8rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  border-radius: 1rpx;
}
.chev.down { transform: rotate(45deg); margin-bottom: 6rpx; }
.chev.up { transform: rotate(-135deg); margin-bottom: -6rpx; }

.style-bar, .dur-bar {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: var(--card);
  border-radius: 16rpx;
}
.style-label, .dur-label {
  font-size: 24rpx;
  color: var(--muted);
  margin-right: 16rpx;
  flex: none;
}
.style-chips, .dur-chips {
  display: flex;
  gap: 12rpx;
  flex: 1;
  flex-wrap: wrap;
}
.style-chip, .dur-chip {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  background: var(--bg);
  color: var(--muted);
  border: 1rpx solid var(--line);
}
.style-chip.on, .dur-chip.on {
  background: var(--pine);
  color: #f5f1e8;
  border-color: var(--pine);
}

.topic-bar {
  margin-top: 20rpx;
  white-space: nowrap;
}
.pills { display: inline-flex; gap: 16rpx; padding: 4rpx 0; }
.pill {
  display: inline-block;
  padding: 10rpx 28rpx;
  border-radius: 28rpx;
  background: var(--card);
  color: var(--pine);
  font-size: 26rpx;
  border: 1rpx solid var(--line);
}

.chat {
  flex: 1;
  min-height: 0;
  margin-top: 24rpx;
  padding: 12rpx;
}
.chat::-webkit-scrollbar { width: 0; height: 0; display: none; }
/* 语音播放条出现时，给底部留出空间，避免遮住最后几条消息 */
.chat-with-audio { padding-bottom: 140rpx; }
.msg {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}
.msg.user { flex-direction: row-reverse; }
.msg-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--pine);
  color: #f5f1e8;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; flex: none;
}
.msg.user .msg-avatar { background: var(--persimmon); }
.msg-body {
  max-width: 74%;
  margin: 0 16rpx;
  padding: 20rpx 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}
.msg.user .msg-body { background: var(--pine); border-color: var(--pine); }
.msg.user .msg-content { color: #f5f1e8; }
.msg-content {
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.7;
  white-space: pre-wrap;
}
.msg-actions { margin-top: 12rpx; display: flex; gap: 16rpx; }
.voice-btn {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(196, 154, 85,0.12);
  color: var(--persimmon);
  font-size: 22rpx;
}
.copy-btn {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(36, 75, 60,0.1);
  color: var(--pine);
  font-size: 22rpx;
}
.typing-dots { display: flex; gap: 8rpx; padding: 6rpx 0; }
.typing-dots i {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--muted);
  animation: blink 1.2s infinite;
}
.typing-dots i:nth-child(2) { animation-delay: 0.2s; }
.typing-dots i:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%,60%,100% { opacity: 0.3; } 30% { opacity: 1; } }

.faqs {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.faq {
  padding: 12rpx 22rpx;
  border-radius: 24rpx;
  background: var(--card);
  color: var(--pine);
  font-size: 24rpx;
  border: 1rpx solid var(--line);
}

.input-bar {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 8rpx -32rpx 0;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--line);
  z-index: 50;
}
.input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: var(--bg);
  border-radius: 36rpx;
  font-size: 28rpx;
}
.send-btn {
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: var(--pine);
  color: #f5f1e8;
  border-radius: 36rpx;
  font-size: 28rpx;
}
.send-btn.disabled { opacity: 0.5; }

.audio-dock {
  position: fixed;
  left: 32rpx; right: 32rpx; bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: var(--pine);
  color: #f5f1e8;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(36, 75, 60,0.3);
  z-index: 60;
}
.audio-title { font-size: 26rpx; }
.audio-ctrls { display: flex; gap: 16rpx; }
.audio-btn {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.15);
  font-size: 24rpx;
}
.audio-btn.play { background: var(--persimmon); }


.source-card { margin: 0 24rpx 12rpx; border-radius: 16rpx; background: #f5f1e8; border: 1rpx solid #e9e3d6; }
.source-head { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 22rpx; }
.source-title { font-size: 24rpx; color: #6f7a73; }
.source-toggle { font-size: 22rpx; color: #a8813f; }
.source-body { padding: 0 22rpx 20rpx; }
.source-note { display: block; font-size: 22rpx; color: #6f7a73; line-height: 1.7; }
.source-updated { display: block; margin-top: 8rpx; font-size: 20rpx; color: #8e9a92; }
.source-links { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 12rpx 0 6rpx; }
.source-link { font-size: 22rpx; color: #4f6b58; background: #eaf0ea; padding: 6rpx 16rpx; border-radius: 999rpx; }
.source-legend { display: block; margin-top: 6rpx; font-size: 20rpx; color: #8e9a92; line-height: 1.6; }
