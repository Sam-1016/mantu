.page {
  min-height: 100vh;
  padding: 0 32rpx 60rpx;
  background: var(--bg);
}

.intro-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-top: 24rpx;
}
.intro-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  background: var(--pine);
  color: #f5f1e8;
  font-size: 22rpx;
  font-family: "Songti SC", serif;
  margin-bottom: 16rpx;
}
.intro-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--pine);
  margin-bottom: 10rpx;
}
.intro-sub {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.action-btn {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 40rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.action-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--pine-soft);
  color: var(--pine);
  font-family: var(--serif);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.action-name { font-size: 30rpx; font-weight: 600; color: var(--pine); }
.action-desc { font-size: 22rpx; color: var(--muted); margin-top: 6rpx; }

.tip-box {
  margin-top: 32rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
}
.tip-title { display: block; font-size: 26rpx; font-weight: 600; color: var(--persimmon); margin-bottom: 12rpx; }
.tip-text { display: block; font-size: 24rpx; color: var(--muted); line-height: 1.8; }

.loading-card {
  margin-top: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
}
.preview { width: 100%; height: 420rpx; display: block; }
.loading-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}
.spinner {
  width: 56rpx; height: 56rpx;
  border: 6rpx solid var(--line);
  border-top-color: var(--pine);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.loading-text { margin-top: 20rpx; font-size: 26rpx; color: var(--muted); }

.result-card {
  margin-top: 24rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
}
.result-img { width: 100%; height: 380rpx; display: block; }
.result-body { padding: 28rpx 32rpx 32rpx; }
.result-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(36, 75, 60,0.1);
  color: var(--pine);
  font-size: 22rpx;
  margin-bottom: 14rpx;
}
.result-tag.no { background: rgba(196, 154, 85,0.1); color: var(--persimmon); }
.result-name {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: var(--pine);
  margin-bottom: 12rpx;
}
.result-intro {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.7;
}

.result-actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.primary-btn {
  background: var(--pine);
  color: #f5f1e8;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.ghost-btn {
  background: transparent;
  border: 2rpx solid var(--line);
  color: var(--pine);
  text-align: center;
  padding: 24rpx 0;
  border-radius: 18rpx;
  font-size: 28rpx;
}

/* 录像识别采集层 */
.record-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: #000;
}
.record-cam { width: 100%; height: 100%; }
.record-panel {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(0,0,0,0.45);
  border-radius: 20rpx;
  padding: 24rpx;
}
.record-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #b0533d;
  animation: recBlink 1s ease-in-out infinite;
}
@keyframes recBlink { 50% { opacity: 0.25; } }
.record-texts { flex: 1; display: flex; flex-direction: column; }
.record-title { font-size: 28rpx; font-weight: 600; color: #fff; }
.record-hint { font-size: 22rpx; color: rgba(255,255,255,0.75); margin-top: 4rpx; }
.record-cancel {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255,255,255,0.5);
  color: #fff;
  font-size: 24rpx;
}

/* ===== 评价聚合分析 ===== */
.review-card {
  margin-top: 24rpx;
  padding: 32rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
}
.review-head { display: flex; align-items: baseline; justify-content: space-between; }
.review-title { font-size: 34rpx; font-weight: 600; color: var(--ink); }
.review-kicker { font-size: 22rpx; color: var(--muted); }
.review-loading { display: flex; align-items: center; padding: 40rpx 0; }
.spinner.small { width: 32rpx; height: 32rpx; border-width: 4rpx; flex: none; }
.review-loading-text { margin-left: 16rpx; font-size: 26rpx; color: var(--muted); }

.review-label {
  display: block;
  margin: 32rpx 0 14rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
}
.review-summary { font-size: 28rpx; line-height: 1.75; color: var(--ink); }

.review-points { margin-top: 12rpx; }
.point-row { display: flex; align-items: flex-start; margin-top: 8rpx; }
.point-dot {
  flex: none;
  width: 32rpx; height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-right: 12rpx;
}
.point-dot.good { background: rgba(36, 75, 60,0.12); color: var(--pine); }
.point-dot.bad { background: rgba(179,64,42,0.12); color: #a5533f; }
.point-text { flex: 1; font-size: 26rpx; line-height: 1.6; color: var(--ink); }

.score-box {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: rgba(36, 75, 60,0.06);
}
.score-main { display: flex; align-items: baseline; }
.score-num { font-size: 72rpx; font-weight: 700; color: var(--pine); line-height: 1; }
.score-max { font-size: 26rpx; color: var(--muted); margin-left: 8rpx; }
.score-label { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--pine); }
.score-src { display: block; margin-top: 14rpx; font-size: 22rpx; line-height: 1.6; color: var(--muted); }

.dim { display: flex; align-items: center; margin-top: 16rpx; }
.dim-block { margin-top: 4rpx; }
.dim-evi { display: block; margin-top: 6rpx; font-size: 21rpx; color: var(--muted); }
.dim-name { width: 150rpx; font-size: 24rpx; color: var(--ink); flex: none; }
.dim-bar {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--line);
  overflow: hidden;
}
.dim-fill { height: 100%; border-radius: 999rpx; background: var(--pine); }
.dim-score { width: 70rpx; text-align: right; font-size: 24rpx; color: var(--muted); }

.quote {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  border-left: 4rpx solid var(--line);
  background: rgba(0,0,0,0.015);
  border-radius: 0 12rpx 12rpx 0;
}
.quote-top { display: flex; align-items: center; }
.quote-platform {
  font-size: 22rpx;
  color: var(--pine);
  background: rgba(36, 75, 60,0.1);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.quote-date { margin-left: 12rpx; font-size: 22rpx; color: var(--muted); }
.quote-link { margin-left: auto; font-size: 22rpx; color: var(--muted); text-decoration: underline; }
.quote-text { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 1.7; color: var(--ink); }
.quote-note { display: block; margin-top: 16rpx; font-size: 22rpx; line-height: 1.6; color: var(--muted); }

.shots-head { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.shots-add { font-size: 24rpx; color: var(--pine); }
.shots { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.shot {
  width: 196rpx; height: 196rpx;
  border-radius: 12rpx;
  margin: 0 12rpx 12rpx 0;
  background: var(--sand);
}
.shots-tip { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }

.result-hint { text-align: center; font-size: 24rpx; color: #8e9a92; margin: 6rpx 0 10rpx; }
.result-hint text { text-decoration: underline; padding: 8rpx 16rpx; }
