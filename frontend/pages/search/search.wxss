.nav-search {
  width: 100%;
  height: 32px;
  padding: 0 12px;
  border-radius: 999px;
  background: #f5f1e8;
  display: flex;
  align-items: center;
}

.nav-input {
  flex: 1;
  height: 32px;
  margin-left: 8px;
  font-size: 14px;
}

.nav-clear {
  margin-left: 8px;
  font-size: 12px;
  color: #6f7a73;
}

.block {
  margin-top: 12rpx;
}

.label {
  display: block;
  margin: 20rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--muted);
  letter-spacing: 2rpx;
}

.words {
  display: flex;
  flex-wrap: wrap;
}

.word {
  margin: 0 16rpx 16rpx 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: 26rpx;
}

.word.hot {
  background: var(--pine-soft);
  border-color: transparent;
  color: var(--pine);
}

.hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.dest-hit {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.dest-hit image {
  width: 120rpx;
  height: 88rpx;
  border-radius: 16rpx;
  margin-right: 18rpx;
  flex: none;
}

.hit-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}

.hit-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.guide-block {
  margin-top: 20rpx;
}

/* 景点命中卡片 */
.spot-hit {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}
.spot-hit image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #e9e3d6;
}
.spot-hit-body {
  flex: 1;
  min-width: 0;
}
.spot-hit-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.spot-hit-top .hit-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #303b35;
}
.hit-from {
  font-size: 20rpx;
  color: #a8813f;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.spot-hit-reason {
  font-size: 24rpx;
  color: #6f7a73;
  line-height: 1.6;
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.spot-hit-reason:first-of-type {
  color: #244b3c;
}
