<view wx:if="{{ready && route}}" class="page">
  <!-- 城市路线切换 -->
  <scroll-view class="route-switch" scroll-x show-scrollbar="{{false}}">
    <view
      class="route-chip {{item.id === currentId ? 'on' : ''}}"
      wx:for="{{routeList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onSwitchRoute"
      hover-class="tap-hover"
      style="margin-left: {{index === 0 ? '32rpx' : '12rpx'}}; margin-right: {{index === routeList.length - 1 ? '32rpx' : '0'}};"
    >{{item.short}}</view>
  </scroll-view>

  <!-- 顶部路线封面 -->
  <view class="route-header">
    <view class="header-bg" style="background-image:url('{{dest.cover}}')"></view>
    <view class="header-mask"></view>
    <view class="header-body">
      <view class="header-tag">{{dest.area || ''}} · {{route.duration}}</view>
      <text class="header-title">{{route.name}}</text>
      <text class="header-desc">{{route.desc}}</text>
    </view>
  </view>

  <!-- 时间线主体 -->
  <view class="timeline">
    <!-- 起点标记 -->
    <view class="start-node">
      <view class="start-dot"></view>
      <text class="start-label">起点</text>
    </view>

    <block wx:for="{{timeline}}" wx:key="key">
      <!-- 景点卡片 -->
      <block wx:if="{{item.type === 'spot'}}">
        <view class="spot-card" bindtap="onSpotTap" data-index="{{item.index}}" hover-class="tap-hover">
          <view class="spot-index-wrap">
            <view class="day-badge">Day {{item.day}}</view>
            <view class="time-badge">
              <view class="time-ico"></view>
              <text>{{item.time}}</text>
            </view>
          </view>
          <view class="spot-main">
            <image class="spot-image" src="{{item.image}}" mode="aspectFill" lazy-load />
            <view class="spot-info">
              <text class="spot-name">{{item.name}}</text>
              <text class="spot-note">{{item.note}}</text>
              <text class="spot-tip">点击查看详情 →</text>
            </view>
          </view>
        </view>

        <!-- 最后一个景点后不画竖线 -->
        <view wx:if="{{item.index < route.spots.length - 1}}" class="timeline-line"></view>
      </block>

      <!-- 段间交通 -->
      <block wx:if="{{item.type === 'segment'}}">
        <view class="segment">
          <view class="segment-body">
            <view class="segment-icon" style="color: {{item.transportColor}}; background-color: {{item.transportColor}}22">
              <text class="icon-text">{{item.transportIcon}}</text>
            </view>
            <view class="segment-info">
              <view class="segment-row">
                <text class="transport-label" style="color: {{item.transportColor}}">{{item.transportLabel}}</text>
                <text class="segment-distance">{{item.distance}} km</text>
              </view>
              <text class="segment-cost">{{item.cost}}</text>
            </view>
          </view>
        </view>
      </block>
    </block>

    <!-- 终点标记 -->
    <view class="end-node">
      <view class="end-dot"></view>
      <text class="end-label">终点</text>
    </view>
  </view>

  <!-- 底部攻略入口 -->
  <view class="bottom-bar" bindtap="goGuide" hover-class="tap-hover">
    <view class="bottom-left">
      <text class="bottom-kicker">查看完整攻略</text>
      <text class="bottom-title">{{dest.name}} · {{route.duration}}路线</text>
    </view>
    <view class="bottom-btn">打开 →</view>
  </view>

  <!-- 景点详情弹窗 -->
  <view wx:if="{{showModal}}" class="modal-mask" bindtap="closeModal">
    <view class="modal-panel" catchtap="stopProp">
      <view class="modal-header">
        <text class="modal-title">{{activeSpot.name}}</text>
        <view class="modal-close" catchtap="closeModal">✕</view>
      </view>

      <!-- 弹窗内搜索框 -->
      <view class="modal-search">
        <view class="s-ico">
          <view class="s-ring"></view>
          <view class="s-bar"></view>
        </view>
        <input
          class="modal-search-input"
          value="{{modalKeyword}}"
          placeholder="在知识中搜索..."
          placeholder-class="modal-search-ph"
          bindinput="onModalSearchInput"
          confirm-type="search"
        />
        <text wx:if="{{modalKeyword}}" class="modal-search-clear" catchtap="onModalSearchClear">✕</text>
      </view>

      <!-- 搜索无结果提示 -->
      <view class="modal-search-empty" wx:if="{{noMatch}}">
        <text>没有找到「{{modalKeyword}}」相关的内容</text>
      </view>

      <scroll-view scroll-y class="modal-body" wx:if="{{spotDetail}}">
        <image lazy-load class="modal-image" src="{{spotDetail.image}}" mode="aspectFill" />

        <!-- 门票/时间/建议 -->
        <view class="meta-row" wx:if="{{spotDetail.ticket || spotDetail.openTime || spotDetail.suggest}}">
          <view class="meta-item" wx:if="{{spotDetail.ticket}}">
            <text class="meta-k">门票</text>
            <text class="meta-v">{{spotDetail.ticket}}</text>
          </view>
          <view class="meta-item" wx:if="{{spotDetail.openTime}}">
            <text class="meta-k">时间</text>
            <text class="meta-v">{{spotDetail.openTime}}</text>
          </view>
          <view class="meta-item" wx:if="{{spotDetail.suggest}}">
            <text class="meta-k">建议</text>
            <text class="meta-v">{{spotDetail.suggest}}</text>
          </view>
        </view>

        <!-- 动态渲染 section -->
        <block wx:for="{{modalSections}}" wx:key="key">
          <!-- 普通文本 section -->
          <view class="modal-section" wx:if="{{item.visible && !item.isFaq}}">
            <text class="section-label">{{item.label}}</text>
            <view class="section-text">
              <text wx:for="{{item.parts}}" wx:for-item="part" wx:for-index="pi" wx:key="pi">
                <text wx:if="{{part.hl}}" class="hl">{{part.text}}</text>
                <text wx:else>{{part.text}}</text>
              </text>
            </view>
          </view>

          <!-- FAQ section -->
          <block wx:if="{{item.isFaq && item.visible}}">
            <text class="section-label">{{item.label}}</text>
            <view class="faq-list">
              <view
                class="faq-item"
                wx:for="{{item.faqs}}"
                wx:for-item="faq"
                wx:for-index="fi"
                wx:key="text"
                wx:if="{{faq.visible}}"
                data-q="{{faq.text}}"
                catchtap="onFaqTap"
                hover-class="faq-hover"
              >
                <view class="faq-main">
                  <text class="faq-q">Q: </text>
                  <text wx:for="{{faq.parts}}" wx:for-item="fp" wx:for-index="fpi" wx:key="fpi">
                    <text wx:if="{{fp.hl}}" class="hl">{{fp.text}}</text>
                    <text wx:else>{{fp.text}}</text>
                  </text>
                </view>
                <text class="faq-go">问 AI ›</text>
              </view>
            </view>
          </block>
        </block>

        <view style="height: 120rpx"></view>
      </scroll-view>

      <view class="modal-actions">
        <view class="action-btn secondary" catchtap="closeModal">关闭</view>
        <view class="action-btn primary" catchtap="onAiGuide">AI 讲解</view>
      </view>
    </view>
  </view>
</view>

<!-- 无数据时 -->
<view wx:if="{{ready && !route}}" class="empty">
  <text class="empty-title">这条路线还在编排中</text>
  <text class="empty-sub">换一个目的地试试吧</text>
</view>
